# Admin panel
ADMIN_PASSWORD=your-admin-password-here

# GitHub Personal Access Token (repo scope) — untuk server-side GitHub API di admin
GITHUB_PAT=github_pat_xxx

# Token signing secret (opsional, auto-derive dari ADMIN_PASSWORD jika tidak diisi)
TOKEN_SECRET=your-random-secret-here

# Google Sheets form handler
SHEET_URL=https://script.google.com/macros/s/your-script-id/exec
