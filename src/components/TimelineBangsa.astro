<section class="section section-timeline section-fs" id="perjalanan">
  <span class="section-number">—</span>
  <div class="layer-bg">
    <div class="timeline-bg-line"></div>
  </div>
  <div class="layer-fg timeline-content">
    <div class="timeline-heading">
      <p class="timeline-sup">Perjalanan Bangsa</p>
      <h2 class="timeline-title">Dari Sumpah Pemuda<br/>Menuju Indonesia Emas</h2>
    </div>

    <div class="timeline-path" id="timelinePath">
      <div class="timeline-line" id="timelineLine"></div>

      <div class="tl-node" data-year="1928">
        <div class="tl-node-marker glass-gold">
          <span class="tl-year">1928</span>
        </div>
        <div class="tl-node-content glass">
          <h3 class="tl-node-title">Sumpah Pemuda</h3>
          <p class="tl-node-desc">Kelahiran Indonesia. Satu tanah air, satu bangsa, satu bahasa. Fondasi persatuan nasional diletakkan oleh pemuda dari seluruh Nusantara.</p>
        </div>
      </div>

      <div class="tl-node" data-year="1945">
        <div class="tl-node-marker glass-gold">
          <span class="tl-year">1945</span>
        </div>
        <div class="tl-node-content glass">
          <h3 class="tl-node-title">Proklamasi Kemerdekaan</h3>
          <p class="tl-node-desc">Indonesia merdeka. Perjuangan bersenjata dan diplomasi mengantarkan bangsa ke gerbang kedaulatan.</p>
        </div>
      </div>

      <div class="tl-node" data-year="1998">
        <div class="tl-node-marker glass-gold">
          <span class="tl-year">1998</span>
        </div>
        <div class="tl-node-content glass">
          <h3 class="tl-node-title">Reformasi</h3>
          <p class="tl-node-desc">Gerakan mahasiswa menggulingkan otoritarianisme. Era demokrasi dan keterbukaan dimulai.</p>
        </div>
      </div>

      <div class="tl-node tl-node--active" data-year="2028">
        <div class="tl-node-marker glass-gold">
          <span class="tl-year">2028</span>
        </div>
        <div class="tl-node-content glass">
          <h3 class="tl-node-title">KSATRIA 2028</h3>
          <p class="tl-node-desc">100 tahun Sumpah Pemuda. Kongres nasional menentukan arah Indonesia untuk abad kedua.</p>
        </div>
      </div>

      <div class="tl-node" data-year="2045">
        <div class="tl-node-marker glass-gold">
          <span class="tl-year">2045</span>
        </div>
        <div class="tl-node-content glass">
          <h3 class="tl-node-title">Indonesia Emas 2045</h3>
          <p class="tl-node-desc">100 tahun Kemerdekaan. Visi Indonesia sebagai negara maju, berdaulat, adil, dan makmur.</p>
        </div>
      </div>
    </div>
  </div>
</section>