<svg class="glow-lines" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id="glowGold" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#C9A84C" stop-opacity="0"/>
      <stop offset="50%" stop-color="#C9A84C" stop-opacity="0.12"/>
      <stop offset="100%" stop-color="#C9A84C" stop-opacity="0"/>
    </linearGradient>
    <linearGradient id="glowWarm" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#C9A84C" stop-opacity="0"/>
      <stop offset="40%" stop-color="#D4A94C" stop-opacity="0.06"/>
      <stop offset="60%" stop-color="#D4A94C" stop-opacity="0.06"/>
      <stop offset="100%" stop-color="#C9A84C" stop-opacity="0"/>
    </linearGradient>
    <filter id="glowBlur">
      <feGaussianBlur stdDeviation="3.5" />
    </filter>
    <filter id="glowBlurSoft">
      <feGaussianBlur stdDeviation="6" />
    </filter>
  </defs>

  <!-- Path 1 — Organic sweep, like a thread caught in wind -->
  <path class="glow-path glow-path--1"
    d="M-80,550 C150,480 300,700 550,520 C750,380 950,600 1200,480 C1350,420 1450,500 1520,450"
    fill="none" stroke="url(#glowGold)" stroke-width="1.2" filter="url(#glowBlur)"/>

  <!-- Path 2 — Gentle wave, lower energy -->
  <path class="glow-path glow-path--2"
    d="M-50,720 C250,620 500,780 800,650 C1050,560 1250,700 1480,620"
    fill="none" stroke="url(#glowWarm)" stroke-width="1" filter="url(#glowBlur)"/>

  <!-- Path 3 — Rising arc, subtle ascent -->
  <path class="glow-path glow-path--3"
    d="M100,850 C350,750 550,550 750,450 C950,350 1200,380 1450,280"
    fill="none" stroke="url(#glowGold)" stroke-width="0.8" filter="url(#glowBlurSoft)" opacity="0.3"/>

  <!-- Path 4 — Short organic curve, mid-left -->
  <path class="glow-path glow-path--4"
    d="M200,380 C350,320 450,400 550,350 C650,300 750,380 850,330"
    fill="none" stroke="#C9A84C" stroke-width="0.6" opacity="0.06"/>
</svg>
