---
import '../styles/base-design.css';
import '../styles/base-layout.css';
import '../styles/base-anim.css';
import '../styles/hero.css';
import '../styles/sections-bg.css';
import '../styles/sections-timeline.css';
import '../styles/sections-overlay.css';
import '../styles/sections-tentang.css';
import '../styles/sections-nilai.css';
import '../styles/sections-kegiatan.css';
import '../styles/sections-komisi.css';
import '../styles/sections-output.css';
import '../styles/sections-representasi.css';
import '../styles/sections-hscroll.css';
import '../styles/sections-kepanitiaan.css';
import '../styles/sections-rundown.css';
import '../styles/sections-registrasi.css';
import '../styles/sections-footer.css';
const { title = "KSATRIA 2028 — Kongres Satu Abad Sumpah Pemuda Republik Indonesia" } = Astro.props;
const description = "KSATRIA 2028 adalah forum nasional pemuda Indonesia memperingati 100 tahun Sumpah Pemuda. 28 Oktober 2028, Gedung MPR RI & GBK Jakarta. 1928: Melahirkan Indonesia — 2028: Menentukan Indonesia.";
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="KSATRIA 2028, Sumpah Pemuda, Kongres Pemuda, Deklarasi Pemuda Indonesia, Indonesia Emas 2045">
  <meta name="author" content="Panitia Nasional KSATRIA 2028">
  <meta property="og:type" content="website">
  <meta property="og:title" content="KSATRIA 2028 — Kongres Satu Abad Sumpah Pemuda Republik Indonesia">
  <meta property="og:description" content="1928: Melahirkan Indonesia — 2028: Menentukan Indonesia. 28 Oktober 2028, Jakarta.">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Event",
    "name": "KSATRIA 2028 — Kongres Satu Abad Sumpah Pemuda",
    "description": "Forum nasional pemuda Indonesia memperingati 100 tahun Sumpah Pemuda. 28 Oktober 2028, Gedung MPR RI & GBK Jakarta.",
    "startDate": "2028-10-28T19:00+07:00",
    "endDate": "2028-10-28T23:00+07:00",
    "location": {
      "@type": "Place",
      "name": "Gelora Bung Karno & Gedung MPR RI",
      "address": { "@type": "PostalAddress", "addressLocality": "Jakarta", "addressCountry": "ID" }
    },
    "organizer": {
      "@type": "Organization",
      "name": "Panitia Nasional KSATRIA 2028"
    }
  }
  </script>
  <style>
    .music-toggle {
      position: fixed;
      bottom: 24px; right: 24px;
      z-index: 9999;
      width: 44px; height: 44px;
      border-radius: 50%;
      background: rgba(5,5,5,0.7);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(201,168,76,0.3);
      color: var(--color-gold);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
      transition: all 0.3s ease;
    }
    .music-toggle:hover {
      border-color: var(--color-gold);
      box-shadow: 0 0 16px rgba(201,168,76,0.2);
    }
    .music-toggle.playing {
      background: rgba(201,168,76,0.1);
      border-color: var(--color-gold);
    }
    .music-toggle .music-icon-on { display: none; }
    .music-toggle .music-icon-off { display: block; }
    .music-toggle.playing .music-icon-on { display: block; }
    .music-toggle.playing .music-icon-off { display: none; }
  </style>
</head>
<body>
  <div class="scroll-progress" id="scrollProgress"></div>
  <slot />
  <audio id="bgm" src="/music.mp3" loop preload="auto"></audio>
  <button id="musicToggle" class="music-toggle" aria-label="Toggle music">
    <span class="music-icon-on">&#9835;</span>
    <span class="music-icon-off">&#9835;</span>
  </button>
  <button id="backToTop" class="back-to-top" aria-label="Back to top">↑</button>
  <noscript>
    <style>
      [data-animate] { opacity: 1 !important; transform: none !important; }
      .scroll-progress { display: none; }
    </style>
  </noscript>
  <script>
    const bgm = document.getElementById('bgm');
    const btn = document.getElementById('musicToggle');
    let playing = false;
    if (bgm && btn) {
      // Auto-play on first user interaction
      const autoplay = () => {
        bgm.play().then(() => { playing = true; btn.classList.add('playing'); }).catch(() => {});
        document.removeEventListener('click', autoplay);
        document.removeEventListener('touchstart', autoplay);
        document.removeEventListener('keydown', autoplay);
      };
      document.addEventListener('click', autoplay);
      document.addEventListener('touchstart', autoplay);
      document.addEventListener('keydown', autoplay);
      // Toggle button
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        playing = !playing;
        if (playing) {
          bgm.play().then(() => btn.classList.add('playing')).catch(() => { playing = false; });
        } else {
          bgm.pause();
          btn.classList.remove('playing');
        }
      });
    }
  </script>
  <script src="../scripts/main-hero.js"></script>
  <script src="../scripts/main-scroll.js"></script>
  <script src="../scripts/main-stagger.js"></script>
  <script src="../scripts/main-utils.js"></script>
</body>
</html>