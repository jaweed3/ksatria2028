---
const { title = "KSATRIA 2028 — Kongres Satu Abad Sumpah Pemuda Republik Indonesia" } = Astro.props;
const description = "KSATRIA 2028 adalah forum nasional pemuda Indonesia memperingati 100 tahun Sumpah Pemuda. 28 Oktober 2028, Gedung MPR RI & GBK Jakarta. 1928: Melahirkan Indonesia — 2028: Menentukan Indonesia.";
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="KSATRIA 2028, Sumpah Pemuda, Kongres Pemuda, Deklarasi Pemuda Indonesia, Indonesia Emas 2045">
  <meta name="author" content="Panitia Nasional KSATRIA 2028">
  <meta property="og:type" content="website">
  <meta property="og:title" content="KSATRIA 2028 — Kongres Satu Abad Sumpah Pemuda Republik Indonesia">
  <meta property="og:description" content="1928: Melahirkan Indonesia — 2028: Menentukan Indonesia. 28 Oktober 2028, Jakarta.">
  <meta property="og:site_name" content="KSATRIA 2028">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400;1,700&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
  <style is:global>
    /* ============================================================
       DESIGN SYSTEM — KSATRIA 2028
       ============================================================ */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }

    :root {
      /* Primary Palette — Deep Luxury */
      --color-crimson:        #8B1A1A;
      --color-crimson-dark:   #5C0F0F;
      --color-crimson-light:  #B02020;
      --color-gold:           #C9A84C;
      --color-gold-light:     #E8C96A;
      --color-gold-dark:      #9A7A30;
      --color-ivory:          #F5F0E8;
      --color-ivory-dark:     #EDE5D5;
      --color-paper:          #FAF7F2;
      --color-deep-black:     #050505;
      --color-charcoal:       #1A1A1A;
      --color-ash:            #2C2C2C;
      --color-text-primary:   #1A0A0A;
      --color-text-secondary: #4A3030;
      --color-text-muted:     #7A6060;
      --color-text-on-dark:   #F5F0E8;
      --color-border:         rgba(139, 26, 26, 0.15);
      --color-border-gold:    rgba(201, 168, 76, 0.3);

      /* Glassmorphism */
      --glass-bg:   rgba(5, 5, 5, 0.55);
      --glass-bg-l: rgba(245, 240, 232, 0.08);
      --glass-bg-g: rgba(201, 168, 76, 0.06);
      --glass-blur: blur(16px);
      --glass-border: 1px solid rgba(245, 240, 232, 0.08);

      /* Typography */
      --font-display: 'Playfair Display', 'Times New Roman', Georgia, serif;
      --font-body:    'Crimson Pro', 'Georgia', Times, serif;
      --font-mono:    'Space Mono', 'Courier New', Courier, monospace;

      /* Type Scale — Cinematic */
      --text-xs:    0.6875rem;
      --text-sm:    0.75rem;
      --text-base:  1rem;
      --text-md:    1.125rem;
      --text-lg:    1.25rem;
      --text-xl:    1.5rem;
      --text-2xl:   2rem;
      --text-3xl:   2.5rem;
      --text-4xl:   clamp(2.5rem, 4vw, 3.5rem);
      --text-5xl:   clamp(3.5rem, 6vw, 6rem);
      --text-massive: clamp(3.5rem, 8vw, 7rem);
      --text-gigantic: clamp(5rem, 14vw, 14rem);

      /* Spacing */
      --section-pad-y: clamp(4rem, 8vw, 8rem);
      --section-pad-x: clamp(1.5rem, 5vw, 4rem);
      --container: 1280px;
      --container-narrow: 840px;

      /* Animation */
      --dur-instant: 80ms; --dur-fast: 200ms; --dur-normal: 400ms;
      --dur-slow: 700ms; --dur-deliberate: 1000ms; --dur-grand: 1400ms;
      --ease-out: cubic-bezier(0.0, 0.0, 0.2, 1);
      --ease-power: cubic-bezier(0.16, 1, 0.3, 1);
      --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
      --ease-snap: cubic-bezier(0.87, 0, 0.13, 1);
    }

    body {
      font-family: var(--font-body);
      color: var(--color-text-primary);
      background: var(--color-deep-black);
      line-height: 1.7;
      font-size: 1.0625rem;
      -webkit-font-smoothing: antialiased;
    }

    /* ============================================================
       LAYER SYSTEM
       ============================================================ */
    .layer-bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
      overflow: hidden;
    }
    .layer-mid {
      position: absolute; inset: 0; z-index: 1; pointer-events: none;
      overflow: hidden;
    }
    .layer-fg {
      position: relative; z-index: 2;
    }

    /* ============================================================
       SECTION SIZE VARIANTS
       ============================================================ */
    .section-fs { min-height: 100vh; display: flex; align-items: center; }
    .section-80 { min-height: 80vh; display: flex; align-items: center; }

    /* ============================================================
       GLASSMORPHISM
       ============================================================ */
    .glass {
      background: var(--glass-bg);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border: var(--glass-border);
    }
    .glass-light {
      background: var(--glass-bg-l);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border: var(--glass-border);
    }
    .glass-gold {
      background: var(--glass-bg-g);
      backdrop-filter: var(--glass-blur);
      -webkit-backdrop-filter: var(--glass-blur);
      border: 1px solid rgba(201, 168, 76, 0.12);
    }

    /* ============================================================
       ASYMMETRIC CONTENT LAYOUT
       ============================================================ */
    .content-split {
      display: grid; grid-template-columns: 1fr 1fr; gap: 4rem;
      align-items: center;
    }
    .content-split--reverse { direction: rtl; }
    .content-split--reverse > * { direction: ltr; }

    @media (max-width: 900px) {
      .content-split { grid-template-columns: 1fr; gap: 2rem; }
    }

    /* Scroll Progress */
    .scroll-progress {
      position: fixed; top: 0; left: 0; width: 0%; height: 3px;
      background: linear-gradient(90deg, var(--color-crimson), var(--color-gold));
      z-index: 9999; transition: width 100ms linear;
    }

    /* ============================================================
       NAVBAR
       ============================================================ */
    .navbar {
      position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
      height: 70px; display: flex; align-items: center;
      padding: 0 var(--section-pad-x);
      transition: all var(--dur-normal) var(--ease-out);
      animation: navbarSlideDown var(--dur-slow) var(--ease-power) 100ms both;
    }
    .navbar.scrolled {
      background: rgba(13, 13, 13, 0.95);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid rgba(201, 168, 76, 0.2);
    }
    .navbar-inner {
      width: 100%; max-width: var(--container); margin: 0 auto;
      display: flex; align-items: center; justify-content: space-between;
    }
    .nav-logo {
      font-family: var(--font-mono); font-size: 0.875rem;
      color: var(--color-gold); text-decoration: none; letter-spacing: 0.15em;
      font-weight: 700;
    }
    .nav-links { display: flex; align-items: center; gap: 2rem; list-style: none; }
    .nav-links a {
      font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--color-text-on-dark);
      text-decoration: none; opacity: 0.8; transition: opacity var(--dur-fast);
      position: relative;
    }
    .nav-links a::after {
      content: ''; position: absolute; bottom: -2px; left: 0; width: 0; height: 1px;
      background: var(--color-gold); transition: width var(--dur-normal) var(--ease-out);
    }
    .nav-links a:hover { opacity: 1; }
    .nav-links a:hover::after { width: 100%; }
    .nav-cta {
      background: var(--color-crimson); color: var(--color-ivory);
      font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em;
      text-transform: uppercase; padding: 0.6rem 1.25rem; border: none;
      text-decoration: none; transition: all var(--dur-fast);
    }
    .nav-cta:hover { background: var(--color-crimson-dark); color: var(--color-gold); }
    .nav-toggle { display: none; background: none; border: none; color: var(--color-gold); font-size: 1.5rem; cursor: pointer; }

    @media (max-width: 900px) {
      .nav-links { display: none; }
      .nav-links.open {
        display: flex; flex-direction: column; position: fixed; inset: 0;
        background: rgba(13, 13, 13, 0.98); backdrop-filter: blur(20px);
        justify-content: center; align-items: center; gap: 2.5rem;
        z-index: 999; animation: navOverlayOpen var(--dur-normal) var(--ease-out);
      }
      .nav-links a { font-size: 1rem; }
      .nav-toggle { display: block; z-index: 1001; }
    }

    /* ============================================================
       SECTION BASE
       ============================================================ */
    .section { padding: var(--section-pad-y) var(--section-pad-x); position: relative; }

    .section-number {
      position: absolute; top: clamp(1rem, 3vw, 3rem); right: clamp(1rem, 3vw, 3rem);
      font-family: var(--font-display); font-size: clamp(4rem, 12vw, 10rem); font-weight: 900;
      line-height: 1; color: currentColor; opacity: 0.03; pointer-events: none; z-index: 0;
      user-select: none;
    }
    .section-inner { max-width: var(--container); margin: 0 auto; }
    .section-inner--narrow { max-width: var(--container-narrow); margin: 0 auto; }

    .section-label {
      font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.2em;
      text-transform: uppercase; text-align: center; margin-bottom: 1.5rem;
    }
    .section-title {
      font-family: var(--font-display); font-size: clamp(2rem, 4.5vw, 3.5rem);
      font-weight: 700; text-align: center; line-height: 1.15; margin-bottom: 1rem;
    }
    .section-divider {
      width: 60px; height: 2px; margin: 1.5rem auto 2rem;
    }
    .section-lead {
      font-size: 1.125rem; text-align: center; max-width: 640px;
      margin: 0 auto 3rem; line-height: 1.8;
    }

    /* ============================================================
       SCROLL ANIMATIONS
       ============================================================ */
    [data-animate] {
      opacity: 0;
      transition: opacity var(--dur-slow) var(--ease-power),
                  transform var(--dur-slow) var(--ease-power);
    }
    [data-animate="fade-up"] { transform: translateY(40px); }
    [data-animate="slide-left"] { transform: translateX(-50px); }
    [data-animate="slide-right"] { transform: translateX(50px); }
    [data-animate="scale-up"] { transform: scale(0.9); }
    [data-animate="fade-in"] { transform: none; }
    [data-animate].is-visible { opacity: 1; transform: none !important; }

    [data-delay="100"] { transition-delay: 100ms; }
    [data-delay="200"] { transition-delay: 200ms; }
    [data-delay="300"] { transition-delay: 300ms; }
    [data-delay="400"] { transition-delay: 400ms; }
    [data-delay="500"] { transition-delay: 500ms; }
    [data-delay="600"] { transition-delay: 600ms; }
    [data-delay="700"] { transition-delay: 700ms; }
    [data-delay="800"] { transition-delay: 800ms; }

    /* ============================================================
       KEYFRAMES
       ============================================================ */
    @keyframes navbarSlideDown {
      from { transform: translateY(-100%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }
    @keyframes navOverlayOpen {
      from { opacity: 0; transform: scale(0.96); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(40px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeDown {
      from { opacity: 0; transform: translateY(-20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes heroWordmark {
      0% { opacity: 0; transform: translateY(60px) scale(0.95); letter-spacing: 0.3em; }
      100% { opacity: 1; transform: translateY(0) scale(1); letter-spacing: normal; }
    }
    @keyframes drawLine {
      from { width: 0; opacity: 0; }
      to { width: 60px; opacity: 1; }
    }
    @keyframes taglineReveal {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes scaleUp {
      from { opacity: 0; transform: scale(0.88); }
      to { opacity: 1; transform: scale(1); }
    }
    @keyframes scrollBounce {
      0%, 100% { transform: translateY(0); opacity: 1; }
      50% { transform: translateY(8px); opacity: 0.6; }
    }
    @keyframes shimmer {
      0% { background-position: -200% center; }
      100% { background-position: 200% center; }
    }
    @keyframes glowPulse {
      0%, 100% { box-shadow: 0 0 0 0 rgba(201, 168, 76, 0); }
      50% { box-shadow: 0 0 20px 4px rgba(201, 168, 76, 0.3); }
    }
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-12px); }
    }

    /* ============================================================
       REDUCED MOTION
       ============================================================ */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
      [data-animate] { opacity: 1 !important; transform: none !important; }
    }


    /* ============================================================
       MOBILE ANIMATION ADJUSTMENTS
       ============================================================ */
    @media (max-width: 767px) {
      [data-animate="fade-up"] { transform: translateY(25px); }
      [data-animate="slide-left"] { transform: translateX(-30px); }
      [data-animate="slide-right"] { transform: translateX(30px); }
      [data-animate] { transition-duration: var(--dur-normal); }
    }

    /* ============================================================
       HERO SECTION — Cinematic Redesign
       ============================================================ */
    .hero {
      position: relative; overflow: hidden; background: var(--color-deep-black);
    }
    .hero-bg-pattern {
      position: absolute; inset: 0; opacity: 0.4;
      background:
        radial-gradient(ellipse 80% 60% at 50% 40%, rgba(139,26,26,0.15) 0%, transparent 70%),
        repeating-linear-gradient(45deg, transparent, transparent 18px, rgba(201,168,76,0.02) 18px, rgba(201,168,76,0.02) 19px),
        repeating-linear-gradient(-45deg, transparent, transparent 18px, rgba(201,168,76,0.02) 18px, rgba(201,168,76,0.02) 19px);
    }
    .hero-noise {
      position: absolute; inset: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
      mix-blend-mode: overlay;
    }

    /* Garuda Silhouette */
    .hero-garuda-wrap {
      display: flex; align-items: center; justify-content: center;
    }
    .hero-garuda {
      width: clamp(300px, 60vw, 700px); height: auto;
      color: rgba(201, 168, 76, 0.04);
      transform: scale(1.1);
      will-change: transform;
    }

    /* Content */
    .hero-content-wrap {
      display: flex; align-items: center; width: 100%;
      padding: 8rem var(--section-pad-x) 4rem;
    }
    .hero-inner {
      max-width: var(--container); margin: 0 auto; width: 100%;
    }
    .hero-label {
      font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-gold);
      letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 1.5rem;
      opacity: 0; transform: translateY(-20px);
    }
    .hero-title-line {
      overflow: hidden; margin-bottom: 0.5rem;
    }
    .hero-title-word {
      display: block;
      font-family: var(--font-display);
      font-size: var(--text-gigantic);
      font-weight: 900; color: var(--color-ivory); line-height: 0.9;
      letter-spacing: -0.03em;
      opacity: 0; transform: translateY(120px) scale(0.95);
    }
    .hero-title-sub {
      font-family: var(--font-mono); font-size: clamp(0.7rem, 1.4vw, 1rem);
      color: var(--color-gold); letter-spacing: 0.15em; text-transform: uppercase;
      margin-bottom: 1.5rem; opacity: 0; transform: translateY(20px);
    }
    .hero-tagline {
      font-family: var(--font-display); font-style: italic;
      font-size: clamp(1.1rem, 2vw, 1.75rem);
      color: rgba(245,240,232,0.6); margin-bottom: 2.5rem;
      opacity: 0; transform: translateY(20px);
    }
    .hero-tagline-sep {
      margin: 0 0.75rem; color: var(--color-gold); opacity: 0.5;
    }

    /* Floating Stat Cards */
    .hero-stats {
      display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2.5rem;
      opacity: 0; transform: translateY(30px);
    }
    .hero-stat {
      padding: 0.75rem 1.25rem; text-align: center; min-width: 100px;
    }
    .hero-stat-num {
      display: block; font-family: var(--font-display);
      font-size: clamp(1.5rem, 3vw, 2.5rem); font-weight: 900;
      color: var(--color-gold); line-height: 1;
    }
    .hero-stat-label {
      display: block; font-family: var(--font-mono);
      font-size: 0.6rem; color: rgba(245,240,232,0.6);
      text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.25rem;
    }

    /* Countdown */
    .hero-countdown {
      display: flex; align-items: center;
      gap: 0.5rem; margin-bottom: 2rem;
      opacity: 0; transform: scale(0.88);
    }
    .cd-block {
      padding: 0.75rem 1rem; min-width: 65px; text-align: center;
    }
    .cd-number {
      font-family: var(--font-mono); font-size: clamp(1.25rem, 2.5vw, 2rem);
      font-weight: 700; color: var(--color-gold); display: block; line-height: 1;
    }
    .cd-label {
      font-family: var(--font-mono); font-size: 0.55rem; color: rgba(245,240,232,0.5);
      text-transform: uppercase; letter-spacing: 0.15em; margin-top: 0.35rem; display: block;
    }
    .cd-sep {
      font-family: var(--font-mono); font-size: 1.25rem; color: var(--color-gold);
      animation: colonPulse 1s ease-in-out infinite; align-self: flex-start; margin-top: 0.25rem;
    }
    @keyframes colonPulse {
      0%, 100% { opacity: 1; } 50% { opacity: 0.3; }
    }

    /* Hero Buttons */
    .hero-buttons {
      display: flex; gap: 1rem; flex-wrap: wrap;
    }
    .hero-btn-1 { opacity: 0; transform: translateY(20px); }
    .hero-btn-2 { opacity: 0; transform: translateY(20px); }

    .scroll-indicator {
      position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%);
      color: var(--color-gold); font-size: 1.5rem; z-index: 3; opacity: 0;
      animation: scrollBounce 2s ease-in-out 2.9s infinite;
    }

    /* ============================================================
       BUTTONS
       ============================================================ */
    .btn-primary {
      display: inline-block; background: var(--color-crimson);
      color: var(--color-ivory); font-family: var(--font-mono);
      font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 0.875rem 2rem; border: 2px solid var(--color-crimson);
      text-decoration: none; cursor: pointer; transition: all var(--dur-normal) var(--ease-out);
    }
    .btn-primary:hover {
      background: var(--color-crimson-dark); border-color: var(--color-gold);
      color: var(--color-gold); transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(139,26,26,0.4);
    }
    .btn-secondary {
      display: inline-block; background: transparent;
      color: var(--color-gold); font-family: var(--font-mono);
      font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 0.875rem 2rem; border: 2px solid var(--color-gold);
      text-decoration: none; cursor: pointer; transition: all var(--dur-normal) var(--ease-out);
    }
    .btn-secondary:hover {
      background: var(--color-gold); color: var(--color-deep-black);
      transform: translateY(-2px);
    }

    /* ============================================================
       SECTION BACKGROUNDS
       ============================================================ */
    .section-tentang { background: var(--color-deep-black); }
    .section-nilai { background: var(--color-crimson); color: var(--color-text-on-dark); }
    .section-nilai .section-label { color: var(--color-gold); }
    .section-nilai .section-title { color: var(--color-text-on-dark); }
    .section-nilai .section-lead { color: rgba(245,240,232,0.8); }
    .section-nilai .section-divider { background: var(--color-gold); }
    .section-kegiatan { background: var(--color-ivory-dark); }
    .section-komisi { background: var(--color-deep-black); color: var(--color-text-on-dark); }
    .section-komisi .section-label { color: var(--color-gold); }
    .section-komisi .section-title { color: var(--color-text-on-dark); }
    .section-komisi .section-lead { color: rgba(245,240,232,0.7); }
    .section-komisi .section-divider { background: var(--color-gold); }
    /* === TIMELINE PERJALANAN BANGSA === */
    .section-timeline {
      position: relative;
      background: var(--color-deep-black);
      color: var(--color-text-on-dark);
      overflow: hidden;
    }
    .section-timeline .section-number { color: var(--color-gold); }
    .timeline-bg-line {
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 2px;
      background: rgba(201,168,76,0.08);
      transform: translateX(-50%);
    }
    .timeline-heading {
      text-align: center;
      padding-top: var(--space-section);
    }
    .timeline-sup {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      letter-spacing: 0.25em;
      color: var(--color-gold);
      text-transform: uppercase;
      margin-bottom: 1rem;
    }
    .timeline-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: clamp(2.5rem, 5vw, 4rem);
      color: var(--color-text-on-dark);
      line-height: 1.15;
    }
    .timeline-path {
      position: relative;
      max-width: 900px;
      margin: 0 auto;
      padding: 6rem 2rem 8rem;
    }
    .timeline-line {
      position: absolute;
      left: 50%;
      top: 0;
      bottom: 0;
      width: 3px;
      background: linear-gradient(to bottom, var(--color-gold), var(--color-crimson));
      transform: translateX(-50%);
      transform-origin: top center;
      scale: 1 0;
    }
    .tl-node {
      position: relative;
      margin-bottom: 6rem;
      display: flex;
      align-items: flex-start;
      opacity: 0;
    }
    .tl-node.tl-node--visible { opacity: 1; }
    .tl-node:last-child { margin-bottom: 0; }
    .tl-node:nth-child(odd) {
      flex-direction: row;
      padding-right: calc(50% + 2rem);
      text-align: right;
    }
    .tl-node:nth-child(even) {
      flex-direction: row-reverse;
      padding-left: calc(50% + 2rem);
      text-align: left;
    }
    .tl-node-marker {
      position: absolute;
      left: 50%;
      top: 0;
      z-index: 2;
      transform: translateX(-50%);
      width: 80px;
      height: 80px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(5,5,5,0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 2px solid var(--color-gold);
    }
    .tl-year {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1rem;
      color: var(--color-gold);
    }
    .tl-node-content {
      padding: 1.5rem 2rem;
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(201,168,76,0.12);
      border-radius: 4px;
    }
    .tl-node-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.5rem;
      color: var(--color-gold);
      margin-bottom: 0.5rem;
    }
    .tl-node-desc {
      font-family: var(--font-body);
      font-size: 0.9rem;
      color: rgba(245,240,232,0.65);
      line-height: 1.6;
    }
    .tl-node:nth-child(odd) .tl-node-content {
      border-right: 3px solid var(--color-gold);
    }
    .tl-node:nth-child(even) .tl-node-content {
      border-left: 3px solid var(--color-gold);
    }
    @media (max-width: 767px) {
      .timeline-line { left: 24px; }
      .tl-node, .tl-node:nth-child(odd), .tl-node:nth-child(even) {
        flex-direction: column;
        padding: 0 0 0 56px;
        text-align: left;
      }
      .tl-node-marker {
        left: 24px;
        width: 48px; height: 48px;
        transform: translateX(-50%);
      }
      .tl-year { font-size: 0.75rem; }
      .tl-node-content {
        border-left: 3px solid var(--color-gold) !important;
        border-right: none !important;
      }
      .tl-node { margin-bottom: 3rem; }
    }
    .section-output { background: var(--color-ivory); }
    .section-representasi { background: var(--color-crimson); color: var(--color-text-on-dark); }
    .section-representasi .section-label { color: var(--color-gold); }
    .section-representasi .section-title { color: var(--color-text-on-dark); }
    .section-representasi .section-lead { color: rgba(245,240,232,0.8); }
    .section-representasi .section-divider { background: var(--color-gold); }
    .section-festival { background: var(--color-deep-black); color: var(--color-text-on-dark); }
    .section-festival .section-label { color: var(--color-gold); }
    .section-festival .section-title { color: var(--color-text-on-dark); }
    .section-festival .section-lead { color: rgba(245,240,232,0.7); }
    .section-festival .section-divider { background: var(--color-gold); }
    .section-konser { background: var(--color-deep-black); color: var(--color-text-on-dark); }
    .section-konser .section-label { color: var(--color-gold); }
    .section-konser .section-title { color: var(--color-text-on-dark); }
    .section-konser .section-lead { color: rgba(245,240,232,0.7); }
    .section-konser .section-divider { background: var(--color-gold); }
    .konser-footnote {
      position: relative;
      z-index: 2;
      font-family: var(--font-body);
      font-size: 0.75rem;
      color: rgba(245,240,232,0.4);
      font-style: italic;
      text-align: center;
      padding: 0 2rem 2rem;
    }
    .section-kepanitiaan { background: var(--color-ivory); }
    .section-rundown { background: var(--color-ivory-dark); }
    .section-registrasi { background: var(--color-crimson); color: var(--color-text-on-dark); }
    .section-registrasi .section-label { color: var(--color-gold); }
    .section-registrasi .section-title { color: var(--color-text-on-dark); }
    .section-registrasi .section-lead { color: rgba(245,240,232,0.8); }
    .section-registrasi .section-divider { background: var(--color-gold); }

    /* Dark section noise overlay */
    .section-komisi, .section-festival, .section-konser { position: relative; }
    .section-komisi::before, .section-festival::before, .section-konser::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.025'/%3E%3C/svg%3E");
      mix-blend-mode: overlay; z-index: 0;
    }
    .section-komisi > *, .section-festival > *, .section-konser > * { position: relative; z-index: 1; }

    .section-nilai, .section-representasi, .section-registrasi { position: relative; overflow: hidden; }
    .section-nilai { clip-path: polygon(0 0, 100% 0, 100% 95%, 0 100%); margin-bottom: -1px; }
    .section-registrasi { clip-path: polygon(0 5%, 100% 0, 100% 100%, 0 100%); margin-top: -1px; }
    .section-nilai::before, .section-representasi::before, .section-registrasi::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background-image:
        repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255,255,255,0.02) 10px, rgba(255,255,255,0.02) 11px),
        repeating-linear-gradient(-45deg, transparent, transparent 10px, rgba(255,255,255,0.02) 10px, rgba(255,255,255,0.02) 11px);
    }

    /* ============================================================
       SECTION LABEL / TITLE / DIVIDER COLOR OVERRIDES
       ============================================================ */
    .section-tentang .section-label { color: var(--color-gold); }
    .section-tentang .section-divider { background: var(--color-gold); }
    .section-output .section-label { color: var(--color-crimson); }
    .section-output .section-divider { background: var(--color-crimson); }
    .section-kepanitiaan .section-label { color: var(--color-crimson); }
    .section-kepanitiaan .section-divider { background: var(--color-crimson); }
    .section-kegiatan .section-label { color: var(--color-crimson); }
    .section-kegiatan .section-divider { background: var(--color-crimson); }
    .section-rundown .section-label { color: var(--color-crimson); }
    .section-rundown .section-divider { background: var(--color-crimson); }

    /* ============================================================
       TENTANG SECTION
       ============================================================ */
    .section-tentang {
      background: var(--color-deep-black);
      color: var(--color-text-on-dark);
      position: relative;
    }
    .section-tentang .section-label { color: var(--color-gold); }
    .section-tentang .section-title { color: var(--color-text-on-dark); }
    .section-tentang .section-lead { color: rgba(245,240,232,0.7); }
    .section-tentang .section-lead strong { color: var(--color-gold); }
    .section-tentang .section-divider { background: var(--color-gold); }
    .section-tentang .content-split {
      max-width: var(--container);
      margin: 0 auto;
      padding: var(--space-section) 2rem 0;
    }
    .tentang-quote {
      padding: 2.5rem 2rem;
      text-align: center;
    }
    .tentang-quote-mark {
      font-family: var(--font-display); font-size: clamp(4rem, 8vw, 8rem);
      color: var(--color-gold); opacity: 0.4; line-height: 0.6; display: block;
    }
    .tentang-quote p {
      font-family: var(--font-display); font-style: italic;
      font-size: clamp(1.5rem, 3.5vw, 2.5rem); color: var(--color-gold);
      line-height: 1.4; font-weight: 600;
    }
    .tentang-values {
      max-width: var(--container);
      margin: 4rem auto 0;
      padding: 0 2rem 4rem;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
    .value-card {
      text-align: center; padding: 2.5rem 1.5rem;
      transition: all var(--dur-normal) var(--ease-out);
    }
    .value-card:hover {
      transform: translateY(-6px);
      border-color: var(--color-gold) !important;
    }
    .value-number {
      font-family: var(--font-mono); font-size: 2.5rem; font-weight: 700;
      color: var(--color-gold); opacity: 0.2; line-height: 1; margin-bottom: 0.5rem;
    }
    .value-title {
      font-family: var(--font-display); font-size: 1.35rem; font-weight: 700;
      color: var(--color-gold); margin-bottom: 0.5rem;
    }
    .value-divider {
      width: 40px; height: 2px; background: var(--color-gold); margin: 0.75rem auto;
    }
    .value-desc { font-size: 0.9rem; color: rgba(245,240,232,0.65); line-height: 1.6; }

    @media (max-width: 767px) {
      .tentang-values { grid-template-columns: 1fr; }
    }

    /* ============================================================
       NILAI DASAR CARDS
       ============================================================ */
    .nilai-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem;
    }
    .nilai-card {
      background: rgba(255,255,255,0.03);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(201,168,76,0.1);
      padding: 2rem 1.5rem; position: relative;
      transition: all var(--dur-normal) var(--ease-out);
    }
    .nilai-card:hover {
      transform: translateY(-6px);
      background: rgba(255,255,255,0.06);
      border-color: var(--color-gold);
    }
    .nilai-card-number {
      font-family: var(--font-mono); font-size: 3rem; font-weight: 700;
      color: var(--color-gold); opacity: 0.1; position: absolute;
      top: 0.75rem; right: 1rem; line-height: 1;
    }
    .nilai-card-title {
      font-family: var(--font-display); font-size: 1.15rem; font-weight: 700;
      color: var(--color-gold); margin-bottom: 0.5rem;
    }
    .nilai-card-divider {
      width: 30px; height: 2px; background: var(--color-gold); margin: 0.75rem 0;
    }
    .nilai-card-desc { font-size: 0.9rem; color: rgba(245,240,232,0.6); line-height: 1.6; }

    @media (max-width: 1023px) { .nilai-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 767px) { .nilai-grid { grid-template-columns: 1fr; } }

    /* ============================================================
       TIMELINE (KEGIATAN)
       ============================================================ */
    .kegiatan-divider { background: var(--color-crimson) !important; }
    .timeline { position: relative; padding: 1rem 0; }
    .timeline::before {
      content: ''; position: absolute; left: 50%; top: 0; bottom: 0;
      width: 2px; background: var(--color-crimson); transform: translateX(-50%);
    }
    .timeline-item {
      display: flex; align-items: flex-start; margin-bottom: 2rem; position: relative;
    }
    .timeline-item:nth-child(odd) { flex-direction: row-reverse; }
    .timeline-marker {
      flex-shrink: 0; width: 100px; display: flex; justify-content: center; position: relative; z-index: 1;
    }
    .timeline-dot {
      width: 14px; height: 14px; border-radius: 50%; background: var(--color-crimson);
      border: 3px solid var(--color-gold); margin-top: 0.5rem;
    }
    .timeline-card {
      flex: 1; max-width: 460px; background: var(--color-paper);
      border-left: 3px solid var(--color-crimson); padding: 1.5rem;
      box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .timeline-item:nth-child(odd) .timeline-card { margin-right: calc(50% + 50px); }
    .timeline-item:nth-child(even) .timeline-card { margin-left: calc(50% + 50px); }
    .timeline-day {
      font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-crimson);
      text-transform: uppercase; letter-spacing: 0.15em; font-weight: 700;
    }
    .timeline-date {
      font-family: var(--font-display); font-size: 1.25rem; font-weight: 700;
      color: var(--color-text-primary); margin: 0.25rem 0 1rem;
    }
    .timeline-events { list-style: none; padding: 0; }
    .timeline-events li {
      padding: 0.35rem 0; font-size: 0.95rem; color: var(--color-text-secondary);
      border-bottom: 1px solid var(--color-border);
    }
    .timeline-events li:last-child { border-bottom: none; }
    .timeline-events .time {
      font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-gold);
      margin-right: 0.5rem; font-weight: 700;
    }

    @media (max-width: 767px) {
      .timeline::before { left: 20px; }
      .timeline-item, .timeline-item:nth-child(odd) { flex-direction: row; }
      .timeline-marker { width: 40px; }
      .timeline-card, .timeline-item:nth-child(odd) .timeline-card, .timeline-item:nth-child(even) .timeline-card {
        margin-left: 50px; margin-right: 0; max-width: none;
      }
    }

    /* ============================================================
       KOMISI CARDS
       ============================================================ */
    .komisi-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
    }
    .komisi-card {
      background: rgba(255,255,255,0.02);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-top: 3px solid var(--color-crimson);
      border-left: 1px solid rgba(201,168,76,0.08);
      border-right: 1px solid rgba(201,168,76,0.08);
      border-bottom: 1px solid rgba(201,168,76,0.08);
      padding: 1.75rem;
      transition: all var(--dur-normal) var(--ease-out);
    }
    .komisi-card:hover {
      transform: translateY(-4px);
      background: rgba(255,255,255,0.04);
      border-top-color: var(--color-gold);
    }
    .komisi-number {
      font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-gold);
      letter-spacing: 0.15em; text-transform: uppercase; margin-bottom: 0.5rem;
    }
    .komisi-title-card {
      font-family: var(--font-display); font-size: 1.15rem; font-weight: 700;
      color: var(--color-text-on-dark); margin-bottom: 0.75rem;
    }
    .komisi-desc {
      font-size: 0.9rem; color: rgba(245,240,232,0.65); line-height: 1.6; margin-bottom: 1rem;
    }
    .komisi-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .tag {
      font-family: var(--font-mono); font-size: 0.6rem; color: rgba(245,240,232,0.5);
      background: rgba(201,168,76,0.1); border: 1px solid rgba(201,168,76,0.15);
      padding: 0.25rem 0.6rem; letter-spacing: 0.05em;
    }

    @media (max-width: 1023px) { .komisi-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 767px) { .komisi-grid { grid-template-columns: 1fr; } }

    /* ============================================================
       OUTPUT CARDS
       ============================================================ */
    .output-hscroll {
      overflow: hidden; width: 100vw; margin-left: calc(-1 * var(--section-pad-x));
      position: relative;
    }
    .output-track {
      display: flex; gap: 1.5rem; width: max-content;
      padding: 2rem var(--section-pad-x) 3rem;
    }
    .output-card {
      width: 360px; flex-shrink: 0;
      background: var(--color-paper); padding: 1.75rem;
      border-left: 3px solid var(--color-crimson);
      transition: all var(--dur-normal) var(--ease-spring);
    }
    .output-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 36px rgba(139,26,26,0.12);
    }
    .output-number {
      font-family: var(--font-mono); font-size: 2rem; font-weight: 700;
      color: var(--color-crimson); opacity: 0.12; line-height: 1; margin-bottom: 0.5rem;
    }
    .output-title {
      font-family: var(--font-display); font-size: 1.1rem; font-weight: 700;
      color: var(--color-crimson); margin-bottom: 0.5rem;
    }
    .output-desc { font-size: 0.9rem; color: var(--color-text-secondary); line-height: 1.6; }
    .output-divider { background: var(--color-crimson) !important; }

    @media (max-width: 767px) {
      .output-card { width: 280px; }
    }

    /* ============================================================
       REPRESENTASI
       ============================================================ */
    .section-representasi { position: relative; }
    .section-representasi::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(201,168,76,0.06) 0%, transparent 70%);
      pointer-events: none;
    }
    .rep-grid {
      display: grid; grid-template-columns: repeat(7, 1fr); gap: 1rem;
    }
    .rep-item {
      text-align: center; padding: 1.5rem 0.5rem;
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      border: 1px solid rgba(201,168,76,0.1);
      transition: all var(--dur-normal) var(--ease-out);
    }
    .rep-item:hover {
      background: rgba(255,255,255,0.08);
      transform: translateY(-4px);
      border-color: var(--color-gold);
    }
    .rep-icon { font-size: 1.75rem; margin-bottom: 0.5rem; }
    .rep-item span {
      font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-on-dark);
      text-transform: uppercase; letter-spacing: 0.05em; line-height: 1.3;
    }

    @media (max-width: 1023px) { .rep-grid { grid-template-columns: repeat(5, 1fr); } }
    @media (max-width: 767px) { .rep-grid { grid-template-columns: repeat(3, 1fr); } }

    /* ============================================================
       HORIZONTAL SCROLL (Festival + Konser)
       ============================================================ */
    .section-hscroll {
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .hscroll-heading {
      flex-shrink: 0;
      max-width: var(--container);
      margin: 0 auto;
      padding: var(--space-section) 2rem 2rem;
      width: 100%;
    }
    .hscroll-viewport {
      overflow: hidden;
      flex: 1;
      min-height: 0;
      padding-bottom: 3rem;
    }
    .hscroll-track {
      display: flex;
      gap: 2rem;
      padding: 0 2rem;
      width: max-content;
    }
    .hscroll-card {
      width: 340px;
      flex-shrink: 0;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(201,168,76,0.1);
      border-radius: 4px;
      padding: 2.5rem 2rem;
      transition: all 0.3s ease;
      cursor: default;
    }
    .hscroll-card:hover {
      background: rgba(255,255,255,0.06);
      border-color: rgba(201,168,76,0.3);
      transform: translateY(-4px);
    }
    .hscroll-card-icon { font-size: 2.5rem; margin-bottom: 1rem; }
    .hscroll-card-title {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.15rem;
      color: var(--color-gold);
      margin-bottom: 0.75rem;
    }
    .hscroll-card-desc { font-size: 0.85rem; color: rgba(245,240,232,0.6); line-height: 1.6; }

    .konser-card {
      width: 280px;
      flex-shrink: 0;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(201,168,76,0.1);
      border-radius: 4px;
      padding: 2rem;
      transition: all 0.3s ease;
      cursor: default;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .konser-card:hover {
      background: rgba(255,255,255,0.06);
      border-color: rgba(201,168,76,0.3);
      transform: translateY(-4px);
    }
    .konser-card--featured {
      border-color: var(--color-gold);
      background: rgba(201,168,76,0.06);
    }
    .konser-badge {
      font-family: var(--font-mono);
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--color-gold);
      margin-bottom: 0.5rem;
    }
    .konser-name {
      font-family: var(--font-display);
      font-weight: 700;
      font-size: 1.25rem;
      color: var(--color-text-on-dark);
      margin-bottom: 0.35rem;
    }
    .konser-genre { font-size: 0.8rem; color: rgba(245,240,232,0.5); }

    @media (max-width: 767px) {
      .hscroll-card { width: 260px; padding: 1.5rem; }
      .konser-card { width: 220px; padding: 1.5rem; }
    }

    /* ============================================================
       KEPANITIAAN
       ============================================================ */
    .panitia-stack { display: flex; flex-direction: column; gap: 2rem; margin-top: 1rem; }
    .panitia-level {
      padding: 2rem; border-left: 3px solid var(--color-crimson);
      background: var(--color-paper);
    }
    .panitia-level-1 { border-left-width: 5px; }
    .panitia-level-label {
      font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-crimson);
      text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 1rem;
    }
    .panitia-names { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .panitia-name {
      font-size: 0.95rem; color: var(--color-text-primary); padding: 0.35rem 0;
    }
    .panitia-name.big {
      font-family: var(--font-display); font-size: 1.15rem; font-weight: 700;
      color: var(--color-crimson);
    }
    .panitia-name.dim { color: var(--color-text-muted); font-style: italic; }
    .panitia-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; width: 100%; }
    .panitia-role { display: flex; flex-direction: column; gap: 0.25rem; }
    .role-title {
      font-family: var(--font-mono); font-size: 0.65rem; color: var(--color-text-muted);
      text-transform: uppercase; letter-spacing: 0.1em;
    }
    .role-name {
      font-family: var(--font-display); font-size: 1.1rem; font-weight: 700;
      color: var(--color-crimson);
    }
    .panitia-divider { background: var(--color-crimson) !important; }

    @media (max-width: 767px) {
      .panitia-grid { grid-template-columns: 1fr; }
      .panitia-names { flex-direction: column; gap: 0.25rem; }
    }

    /* ============================================================
       RUNDOWN
       ============================================================ */
    .rundown-divider { background: var(--color-crimson) !important; }
    .rundown-timeline { display: flex; flex-direction: column; gap: 0; margin-top: 1rem; }
    .rundown-item {
      display: flex; align-items: baseline; gap: 1.5rem; padding: 0.85rem 0;
      border-bottom: 1px solid var(--color-border);
    }
    .rundown-item:last-child { border-bottom: none; }
    .rundown-time {
      font-family: var(--font-mono); font-size: 0.8rem; color: var(--color-gold);
      font-weight: 700; white-space: nowrap; min-width: 120px;
    }
    .rundown-event { font-size: 0.95rem; color: var(--color-text-primary); }
    .rundown-item-highlight {
      background: rgba(139,26,26,0.06); padding: 0.85rem 1rem; margin: 0 -1rem;
      border-left: 3px solid var(--color-crimson); border-bottom: none;
    }
    .rundown-item-highlight .rundown-event { font-weight: 700; color: var(--color-crimson); }

    @media (max-width: 767px) {
      .rundown-item { flex-direction: column; gap: 0.25rem; }
      .rundown-time { min-width: auto; }
    }

    /* ============================================================
       REGISTRASI FORM
       ============================================================ */
    .section-registrasi { position: relative; overflow: hidden; }
    .section-registrasi::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 70% 50% at 50% 30%, rgba(201,168,76,0.08) 0%, transparent 70%);
      pointer-events: none;
    }
    .registrasi-quote {
      text-align: center; font-family: var(--font-display); font-style: italic;
      font-size: 1.25rem; color: var(--color-gold); margin: 1.5rem 0;
    }
    .registrasi-form {
      max-width: 560px; margin: 0 auto;
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(201,168,76,0.12);
      padding: 2.5rem;
    }
    .form-group { margin-bottom: 1.25rem; }
    .form-group label {
      display: block; font-family: var(--font-mono); font-size: 0.7rem;
      color: var(--color-gold); text-transform: uppercase;
      letter-spacing: 0.1em; margin-bottom: 0.5rem;
    }
    .form-group label .required { color: var(--color-ivory); }
    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%; padding: 0.75rem 1rem;
      background: rgba(5,5,5,0.4);
      border: 1px solid rgba(201,168,76,0.15);
      font-family: var(--font-body);
      font-size: 1rem; color: var(--color-ivory);
      transition: border-color var(--dur-fast);
    }
    .form-group input::placeholder,
    .form-group textarea::placeholder { color: rgba(245,240,232,0.3); }
    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      outline: none; border-color: var(--color-gold);
      box-shadow: 0 0 0 3px rgba(201,168,76,0.1);
    }
    .form-group select option { background: var(--color-deep-black); color: var(--color-ivory); }
    .form-group textarea { resize: vertical; min-height: 100px; }
    .btn-submit {
      width: 100%; padding: 1rem; background: var(--color-gold);
      color: var(--color-deep-black); font-family: var(--font-mono);
      font-size: 0.8rem; font-weight: 700; letter-spacing: 0.15em;
      text-transform: uppercase; border: none; cursor: pointer;
      transition: all var(--dur-normal) var(--ease-out);
    }
    .btn-submit:hover {
      background: var(--color-gold-light); transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(201,168,76,0.3);
    }
    .form-thanks {
      max-width: 560px; margin: 0 auto; text-align: center; padding: 3rem 2rem;
      background: rgba(255,255,255,0.04);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(201,168,76,0.12);
    }
    .thanks-icon {
      font-size: 3rem; color: var(--color-gold); margin-bottom: 1rem;
    }
    .thanks-title {
      font-family: var(--font-display); font-size: 1.5rem; font-weight: 700;
      color: var(--color-crimson); margin-bottom: 0.5rem;
    }
    .thanks-desc { color: var(--color-text-secondary); }
    .registrasi-alt {
      text-align: center; margin-top: 2rem; font-size: 0.9rem;
      color: rgba(245,240,232,0.7);
    }
    .registrasi-alt strong { color: var(--color-gold); }

    @media (max-width: 767px) {
      .registrasi-form { padding: 1.5rem; }
    }

    /* ============================================================
       FOOTER
       ============================================================ */
    .footer {
      background: var(--color-deep-black); color: var(--color-text-on-dark);
      padding: var(--section-pad-y) var(--section-pad-x);
      position: relative;
    }
    .footer::before {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.02'/%3E%3C/svg%3E");
      mix-blend-mode: overlay; z-index: 0;
    }
    .footer > * { position: relative; z-index: 1; }
    .footer-grid {
      display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 3rem;
      max-width: var(--container); margin: 0 auto;
    }
    .footer-logo {
      font-family: var(--font-mono); font-size: 1.25rem; font-weight: 700;
      color: var(--color-gold); letter-spacing: 0.1em; margin-bottom: 0.75rem;
    }
    .footer-desc { font-size: 0.9rem; color: rgba(245,240,232,0.7); margin-bottom: 0.5rem; }
    .footer-info { font-family: var(--font-mono); font-size: 0.7rem; color: rgba(245,240,232,0.5); }
    .footer-heading {
      font-family: var(--font-mono); font-size: 0.7rem; color: var(--color-gold);
      text-transform: uppercase; letter-spacing: 0.15em; margin-bottom: 1rem;
    }
    .footer-nav ul, .footer-contact ul { list-style: none; padding: 0; }
    .footer-nav li, .footer-contact li { margin-bottom: 0.5rem; }
    .footer-nav a {
      color: rgba(245,240,232,0.7); text-decoration: none; font-size: 0.9rem;
      transition: color var(--dur-fast);
    }
    .footer-nav a:hover { color: var(--color-gold); }
    .footer-contact li { font-size: 0.9rem; color: rgba(245,240,232,0.6); }
    .footer-social-heading { margin-top: 1.5rem; }
    .footer-divider {
      max-width: var(--container); margin: 3rem auto;
      height: 1px; background: rgba(201,168,76,0.2);
    }
    .footer-quote {
      text-align: center; font-family: var(--font-display); font-style: italic;
      font-size: 1.1rem; color: var(--color-gold); margin: 1.5rem 0;
    }
    .footer-copy {
      text-align: center; font-size: 0.8rem; color: rgba(245,240,232,0.5);
    }
    .footer-note {
      text-align: center; font-size: 0.7rem; color: rgba(245,240,232,0.3); margin-top: 0.5rem;
    }

    @media (max-width: 767px) {
      .footer-grid { grid-template-columns: 1fr; gap: 2rem; }
    }
  </style>
</head>
<body>
  <div class="scroll-progress" id="scrollProgress"></div>
  <slot />
  <noscript>
  <style is:global>
      [data-animate] { opacity: 1 !important; transform: none !important; }
      .scroll-progress { display: none; }
    </style>
  </noscript>
  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // ============================================================
    // HERO — Cinematic Timeline (3-4s)
    // ============================================================
    const heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // 1. Background slowly scales
    heroTl.to('.hero-garuda', {
      scale: 1, duration: 2.5, ease: 'power1.out',
    }, 0);

    // 2. Label fades in
    heroTl.to('.hero-label', { opacity: 1, y: 0, duration: 0.5 }, 0.4);

    // 3. Massive title word reveal
    heroTl.to('.hero-title-word', {
      opacity: 1, y: 0, scale: 1, duration: 1.0, ease: 'power2.out',
    }, 0.6);

    // 4. Subtitle
    heroTl.to('.hero-title-sub', { opacity: 1, y: 0, duration: 0.5 }, 1.2);

    // 5. Tagline
    heroTl.to('.hero-tagline', { opacity: 1, y: 0, duration: 0.6 }, 1.5);

    // 6. Stat cards reveal one by one
    heroTl.to('.hero-stat', {
      opacity: 1, y: 0, duration: 0.4, stagger: 0.12,
    }, 1.8);

    // 7. Countdown appears
    heroTl.to('.hero-countdown', {
      opacity: 1, scale: 1, duration: 0.5, ease: 'back.out(1.4)',
    }, 2.3);

    // 8. CTA buttons
    heroTl.to('.hero-btn-1', { opacity: 1, y: 0, duration: 0.4 }, 2.7);
    heroTl.to('.hero-btn-2', { opacity: 1, y: 0, duration: 0.4 }, 2.85);

    // 9. Scroll indicator
    heroTl.to('.scroll-indicator', { opacity: 1, duration: 0.4 }, 3.1);

    // ============================================================
    // TIMELINE — Growing Line + Node Reveal
    // ============================================================
    const timelineLine = document.getElementById('timelineLine');
    const tlNodes = gsap.utils.toArray('.tl-node');
    if (timelineLine) {
      gsap.to(timelineLine, {
        scaleY: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: '.section-timeline',
          start: 'top center',
          end: 'bottom center',
          scrub: 1.2,
        }
      });
    }
    if (tlNodes.length) {
      tlNodes.forEach((node, i) => {
        ScrollTrigger.create({
          trigger: node,
          start: 'top 85%',
          onEnter: () => {
            node.classList.add('tl-node--visible');
            gsap.fromTo(node, { opacity: 0, y: 60 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', delay: i * 0.15 });
          },
          once: true,
        });
      });
    }

    // ============================================================
    // HORIZONTAL SCROLL — Festival + Konser
    // ============================================================
    const hscrollSections = document.querySelectorAll('.section-hscroll');
    hscrollSections.forEach((section) => {
      const viewport = section.querySelector('.hscroll-viewport');
      const track = section.querySelector('.hscroll-track');
      if (!viewport || !track) return;

      const getTravel = () => -(track.scrollWidth - window.innerWidth + 64);

      gsap.to(track, {
        x: getTravel,
        ease: 'none',
        scrollTrigger: {
          trigger: section,
          start: 'top top',
          end: () => '+=' + Math.abs(getTravel()),
          pin: true,
          scrub: 1,
          invalidateOnRefresh: true,
        }
      });
    });

    // ============================================================
    // OUTPUT — Horizontal Scroll (Fake)
    // ============================================================
    const outputSection = document.querySelector('.section-output');
    const outputTrack = document.querySelector('.output-track');
    if (outputSection && outputTrack) {
      const getTravel = () => -(outputTrack.scrollWidth - window.innerWidth + 64);

      gsap.to(outputTrack, {
        x: getTravel,
        ease: 'none',
        scrollTrigger: {
          trigger: outputSection,
          start: 'top top',
          end: () => '+=' + Math.abs(getTravel()),
          pin: true,
          scrub: 1,
          invalidateOnRefresh: true,
        }
      });
    }

    // ============================================================
    // SCROLL PROGRESS BAR
    // ============================================================
    gsap.to('#scrollProgress', {
      width: '100%',
      ease: 'none',
      scrollTrigger: {
        scrub: 0.3,
        start: 'top top',
        end: 'bottom bottom',
      }
    });

    // ============================================================
    // NAVBAR — Scroll Effect
    // ============================================================
    const navbar = document.querySelector('.navbar');
    ScrollTrigger.create({
      start: 'top -80px',
      onToggle: self => {
        if (navbar) navbar.classList.toggle('scrolled', self.isActive);
      }
    });

    // ============================================================
    // SCROLL REVEALS — [data-animate] elements
    // ============================================================
    const animateMap = {
      'fade-up':    { y: 50, opacity: 0 },
      'slide-left':  { x: -50, opacity: 0 },
      'slide-right': { x: 50, opacity: 0 },
      'scale-up':   { scale: 0.88, opacity: 0 },
      'fade-in':    { opacity: 0 },
    };

    gsap.utils.toArray('[data-animate]').forEach(el => {
      const type = el.getAttribute('data-animate') || 'fade-up';
      const delay = parseInt(el.getAttribute('data-delay')) || 0;
      const vars = animateMap[type] || animateMap['fade-up'];

      gsap.fromTo(el, vars, {
        ...Object.fromEntries(Object.keys(vars).map(k => [k, undefined])),
        opacity: 1,
        duration: 0.8,
        ease: 'power3.out',
        delay: delay / 1000,
        scrollTrigger: {
          trigger: el,
          start: 'top 88%',
          toggleActions: 'play none none none',
        }
      });
    });

    // ============================================================
    // SECTION NUMBERS — scroll-driven opacity
    // ============================================================
    gsap.utils.toArray('.section-number').forEach(num => {
      gsap.fromTo(num,
        { opacity: 0 },
        {
          opacity: 0.03,
          duration: 0.6,
          scrollTrigger: {
            trigger: num.closest('.section'),
            start: 'top 85%',
          }
        }
      );
    });

    // ============================================================
    // COUNTDOWN TIMER
    // ============================================================
    function updateCountdown() {
      const target = new Date('2028-10-28T19:00:00+07:00');
      const diff = target - new Date();
      if (diff <= 0) {
        document.querySelectorAll('.cd-number').forEach(el => el.textContent = '00');
        return;
      }
      const d = Math.floor(diff / 86400000);
      const h = Math.floor((diff % 86400000) / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const s = Math.floor((diff % 60000) / 1000);
      document.getElementById('cd-days').textContent = String(d).padStart(3, '0');
      document.getElementById('cd-hours').textContent = String(h).padStart(2, '0');
      document.getElementById('cd-minutes').textContent = String(m).padStart(2, '0');
      document.getElementById('cd-seconds').textContent = String(s).padStart(2, '0');
    }
    updateCountdown();
    setInterval(updateCountdown, 1000);

    // ============================================================
    // MOBILE NAV TOGGLE
    // ============================================================
    const navToggle = document.querySelector('.nav-toggle');
    const navLinks = document.querySelector('.nav-links');
    if (navToggle && navLinks) {
      navToggle.addEventListener('click', () => navLinks.classList.toggle('open'));
      navLinks.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => navLinks.classList.remove('open'));
      });
    }

    // ============================================================
    // FORM SUBMIT HANDLER
    // ============================================================
    const form = document.getElementById('registrasiForm');
    const thanks = document.getElementById('formThanks');
    if (form && thanks) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.style.display = 'none';
        thanks.style.display = 'block';
      });
    }
  </script>
</body>
</html>
