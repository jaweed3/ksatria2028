---
import '../styles/base-design.css';
import '../styles/base-layout.css';
import '../styles/base-anim.css';
import '../styles/hero.css';
import '../styles/sections-bg.css';
import '../styles/sections-timeline.css';
import '../styles/sections-overlay.css';
import '../styles/sections-tentang.css';
import '../styles/sections-nilai.css';
import '../styles/sections-kegiatan.css';
import '../styles/sections-komisi.css';
import '../styles/sections-output.css';
import '../styles/sections-representasi.css';
import '../styles/sections-hscroll.css';
import '../styles/sections-kepanitiaan.css';
import '../styles/sections-rundown.css';
import '../styles/sections-registrasi.css';
import '../styles/sections-footer.css';
const { title = "KSATRIA 2028 — Kongres Satu Abad Sumpah Pemuda Republik Indonesia" } = Astro.props;
const description = "KSATRIA 2028 adalah forum nasional pemuda Indonesia memperingati 100 tahun Sumpah Pemuda. 28 Oktober 2028, Gedung MPR RI & GBK Jakarta. 1928: Melahirkan Indonesia — 2028: Menentukan Indonesia.";
---
<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="KSATRIA 2028, Sumpah Pemuda, Kongres Pemuda, Deklarasi Pemuda Indonesia, Indonesia Emas 2045">
  <meta name="author" content="Panitia Nasional KSATRIA 2028">
  <meta property="og:type" content="website">
  <meta property="og:title" content="KSATRIA 2028 — Kongres Satu Abad Sumpah Pemuda Republik Indonesia">
  <meta property="og:description" content="1928: Melahirkan Indonesia — 2028: Menentukan Indonesia. 28 Oktober 2028, Jakarta.">
  <meta property="og:site_name" content="KSATRIA 2028">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,700&family=Inter:wght@300;400;600;700&family=IBM+Plex+Mono:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>
  <div class="scroll-progress" id="scrollProgress"></div>
  <slot />
  <noscript>
    <style>
      [data-animate] { opacity: 1 !important; transform: none !important; }
      .scroll-progress { display: none; }
    </style>
  </noscript>
  <script src="../scripts/main-hero.js"></script>
  <script src="../scripts/main-scroll.js"></script>
  <script src="../scripts/main-stagger.js"></script>
  <script src="../scripts/main-utils.js"></script>
</body>
</html>