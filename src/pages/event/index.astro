---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
const events = await getCollection('events');
events.sort((a, b) => new Date(b.data.date || 0) - new Date(a.data.date || 0));
const featured = events.filter(e => e.data.featured)[0] || events[0];
const rest = events.filter(e => e !== featured);
---
<Layout>
<Navbar />
<main>
<section class="event-section">
  <div class="event-inner">
    <div class="event-heading">
      <p class="section-label">— Rangkaian Acara —</p>
      <h1>Kalender Acara KSATRIA 2028</h1>
      <div class="section-divider"></div>
    </div>

    {featured && (
      <a href={`/event/${featured.id}`} class="event-featured">
        <div class="event-featured-img-wrap">
          {featured.data.image
            ? <img src={featured.data.image} alt="" class="event-featured-img" />
            : <div class="event-featured-img-placeholder">KSATRIA</div>
          }
          <div class="event-featured-overlay">
            <span class="event-type-badge">{featured.data.type || 'acara'}</span>
            <p class="event-featured-date">
              {featured.data.date?.toLocaleDateString('id-ID', { year:'numeric', month:'long', day:'numeric' })}
              {featured.data.timeStart && <span> · {featured.data.timeStart}</span>}
            </p>
            <h2 class="event-featured-title">{featured.data.title}</h2>
            {featured.data.location && <p class="event-featured-location">{featured.data.location}</p>}
          </div>
        </div>
      </a>
    )}

    <div class="event-grid">
      {rest.map(ev => (
        <a href={`/event/${ev.id}`} class="event-card">
          {ev.data.image
            ? <img src={ev.data.image} alt="" class="event-card-img" />
            : <div class="event-card-img-placeholder">✦</div>
          }
          <div class="event-card-body">
            <div class="event-card-top">
              <span class="event-type-badge">{ev.data.type || 'acara'}</span>
              <p class="event-card-date">
                {ev.data.date?.toLocaleDateString('id-ID', { year:'numeric', month:'long', day:'numeric' })}
              </p>
            </div>
            <h3 class="event-card-title">{ev.data.title}</h3>
            {ev.data.location && <p class="event-card-location">{ev.data.location}</p>}
            {ev.data.timeStart && <p class="event-card-time">{ev.data.timeStart}{ev.data.timeEnd ? ` – ${ev.data.timeEnd}` : ''}</p>}
          </div>
        </a>
      ))}
    </div>

    {events.length === 0 && <p class="event-empty">Belum ada acara. Pantau terus untuk informasi terbaru.</p>}
  </div>
</section>
</main>
<Footer />
</Layout>
