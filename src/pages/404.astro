---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — Halaman Tidak Ditemukan">
  <main class="error-page">
    <div class="error-inner">
      <h1 class="error-code">404</h1>
      <p class="error-label">HALAMAN TIDAK DITEMUKAN</p>
      <p class="error-desc">Halaman yang Anda cari mungkin telah dipindahkan atau tidak tersedia.</p>
      <a href="/" class="error-btn">Kembali ke Beranda</a>
    </div>
  </main>
</Layout>

<style is:global>
  .error-page { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #0D0D0D; padding: 2rem; }
  .error-inner { text-align: center; max-width: 480px; }
  .error-code { font-family: 'Playfair Display', serif; font-size: clamp(6rem, 20vw, 12rem); font-weight: 900; color: rgba(201,168,76,0.08); line-height: 1; margin: 0; letter-spacing: -0.03em; }
  .error-label { font-family: 'Space Mono', monospace; font-size: 0.75rem; letter-spacing: 0.2em; color: var(--color-gold); text-transform: uppercase; margin: 0 0 1.5rem; }
  .error-desc { font-family: 'Crimson Pro', serif; font-size: 1.1rem; color: rgba(245,240,232,0.5); line-height: 1.7; margin-bottom: 2.5rem; }
  .error-btn { display: inline-block; padding: 0.85rem 2.5rem; background: var(--color-crimson); color: var(--color-ivory); font-family: 'Space Mono', monospace; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; text-decoration: none; transition: all 0.2s; }
  .error-btn:hover { background: var(--color-crimson-dark); color: var(--color-gold); }
</style>
