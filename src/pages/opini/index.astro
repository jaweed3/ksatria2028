---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';
const allPosts = await getCollection('posts');
const items = allPosts.filter(p => p.data.category === 'Opini').sort((a, b) => new Date(b.data.date || 0) - new Date(a.data.date || 0));
const serialized = JSON.stringify(items.map(p => ({ id: p.id, title: p.data.title, date: p.data.date?.toISOString() || '', image: p.data.image || '', category: p.data.category || '', body: (p.body || '').slice(0, 180) })));
---
<Layout>
<Navbar />
<main>
<section class="blog-section">
  <div class="blog-inner">
    <div class="blog-heading" data-animate="fade-up">
      <p class="section-label">— OPINI —</p>
      <h1>Opini & Gagasan Kebangsaan</h1>
      <p class="blog-lead">Perspektif, refleksi, dan gagasan strategis dari tokoh muda Indonesia untuk masa depan bangsa.</p>
      <div class="section-divider"></div>
    </div>
    <div id="opiniContainer" class="blog-posts">
      <div class="loading" style="text-align:center;padding:3rem;color:var(--color-text-muted)">Memuat opini...</div>
    </div>
    <div id="opiniData" data-items={serialized} style="display:none"></div>
  </div>
</section>
</main>
<Footer />
</Layout>

<script>
(function(d) {
  var raw = d.getElementById('opiniData');
  if (!raw) return;
  var items;
  try { items = JSON.parse(raw.dataset.items); } catch(e) { items = []; }
  var container = d.getElementById('opiniContainer');
  if (!items.length) { container.innerHTML = '<p style="text-align:center;padding:3rem;color:var(--color-text-muted)">Belum ada opini.</p>'; return; }
  var featured = items[0], html = '<article class="blog-featured">';
  if (featured.image) html += '<img src="' + esc(featured.image) + '" alt="' + esc(featured.title) + '" class="blog-featured-img" loading="lazy">';
  html += '<div class="blog-featured-body"><div class="blog-meta"><span class="blog-cat-badge">Opini</span>' + (featured.date ? ' · ' + new Date(featured.date).toLocaleDateString('id-ID', {year:'numeric',month:'long',day:'numeric'}) : '') + '</div><h2 class="blog-featured-title"><a href="/blog/' + featured.id + '">' + esc(featured.title) + '</a></h2><p class="blog-excerpt">' + esc(featured.body) + '</p><a href="/blog/' + featured.id + '" class="blog-readmore">Baca Selengkapnya →</a></div></article>';
  html += '<div class="blog-grid">';
  for (var i = 1; i < items.length; i++) {
    var p = items[i];
    html += '<article class="blog-card">';
    if (p.image) html += '<a href="/blog/' + p.id + '"><img src="' + esc(p.image) + '" alt="' + esc(p.title) + '" class="blog-card-img" loading="lazy"></a>';
    html += '<div class="blog-card-body"><div class="blog-meta"><span class="blog-cat-badge">Opini</span>' + (p.date ? ' · ' + new Date(p.date).toLocaleDateString('id-ID', {year:'numeric',month:'long',day:'numeric'}) : '') + '</div><h3 class="blog-card-title"><a href="/blog/' + p.id + '">' + esc(p.title) + '</a></h3><p class="blog-excerpt">' + esc(p.body) + '</p><a href="/blog/' + p.id + '" class="blog-readmore">Baca →</a></div></article>';
  }
  html += '</div>';
  container.innerHTML = html;
  function esc(s) { var e = d.createElement('div'); e.textContent = s || ''; return e.innerHTML; }
})(document);
</script>
