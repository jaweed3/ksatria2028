---
export const prerender = true;
import '../../styles/base-design.css';
import '../../styles/blog.css';
import { getCollection, getEntry, render } from 'astro:content';
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({ params: { slug: post.id } }));
}
const { slug } = Astro.params;
const post = await getEntry('posts', slug);
const { Content } = await render(post);
---

<section class="blog-section">
  <div class="blog-inner blog-article">
    <a href="/blog" class="blog-back">← Kembali ke Blog</a>

    <p class="blog-article-date">
      {post.data.date?.toLocaleDateString('id-ID', { year:'numeric', month:'long', day:'numeric' })}
    </p>
    <div class="blog-tags">
      {post.data.tags?.map(t => <span class="blog-tag">{t}</span>)}
    </div>
    <h1>{post.data.title}</h1>

    {post.data.image && <img src={post.data.image} alt="" class="blog-article-img" />}

    <div class="blog-article-body">
      <Content />
    </div>
  </div>
</section>
