---
export const prerender = true;
import '../../styles/base-design.css';
import '../../styles/blog.css';
import { getCollection } from 'astro:content';
const posts = await getCollection('posts');
posts.sort((a, b) => new Date(b.data.date || 0) - new Date(a.data.date || 0));
const featured = posts[0];
const rest = posts.slice(1);
---

<section class="blog-section">
  <div class="blog-inner">
    <div class="blog-heading">
      <p class="section-label">— Blog KSATRIA 2028 —</p>
      <h1>Berita & Informasi</h1>
      <div class="section-divider"></div>
    </div>

    {featured && (
      <a href={`/blog/${featured.id}`} class="blog-featured">
        <div class="blog-featured-img-wrap">
          {featured.data.image
            ? <img src={featured.data.image} alt="" class="blog-featured-img" />
            : <div class="blog-featured-img-placeholder">KSATRIA</div>
          }
          <div class="blog-featured-overlay">
            <p class="blog-featured-date">
              {featured.data.date?.toLocaleDateString('id-ID', { year:'numeric', month:'long', day:'numeric' })}
            </p>
            <div class="blog-tags">
              {featured.data.tags?.map(t => <span class="blog-tag">{t}</span>)}
            </div>
            <h2 class="blog-featured-title">{featured.data.title}</h2>
            <p class="blog-featured-excerpt">{featured.body.slice(0, 180)}...</p>
          </div>
        </div>
      </a>
    )}

    <div class="blog-grid">
      {rest.map(post => (
        <a href={`/blog/${post.id}`} class="blog-card">
          {post.data.image
            ? <img src={post.data.image} alt="" class="blog-card-img" />
            : <div class="blog-card-img-placeholder">✦</div>
          }
            <p class="blog-card-date">
            {post.data.date?.toLocaleDateString('id-ID', { year:'numeric', month:'long', day:'numeric' })}
            </p>
            <div class="blog-tags">
              {post.data.tags?.map(t => <span class="blog-tag">{t}</span>)}
            </div>
            <h3 class="blog-card-title">{post.data.title}</h3>
            <p class="blog-card-excerpt">{post.body.slice(0, 120)}...</p>
        </a>
      ))}
    </div>

    {posts.length === 0 && <p class="blog-empty">Belum ada artikel. Silakan tulis lewat panel admin.</p>}
  </div>
</section>
