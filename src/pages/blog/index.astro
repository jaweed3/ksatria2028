---
import { getCollection } from 'astro:content';
const posts = await getCollection('posts');
posts.sort((a, b) => new Date(b.data.date || 0) - new Date(a.data.date || 0));
---

<section class="section" style="background:#050505;color:#F5F0E8;min-height:100vh">
  <div class="section-inner" style="padding:8rem 0 4rem">
    <p class="section-label" style="color:#C9A84C">— Blog KSATRIA 2028 —</p>
    <h1 class="section-title">Berita & Informasi</h1>
    <div class="section-divider" style="background:#C9A84C;width:60px;height:2px;margin:1.5rem auto 3rem"></div>

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:2rem">
      {posts.map(post => (
        <a href={`/blog/${post.slug}`} style="text-decoration:none;color:inherit;display:block;padding:2rem;background:rgba(255,255,255,0.02);border:1px solid rgba(201,168,76,0.1);transition:all .3s"
        onmouseover="this.style.background='rgba(201,168,76,0.06)';this.style.borderColor='#C9A84C'"
        onmouseout="this.style.background='rgba(255,255,255,0.02)';this.style.borderColor='rgba(201,168,76,0.1)'">
          {post.data.image && <img src={post.data.image} alt="" style="width:100%;height:200px;object-fit:cover;margin-bottom:1rem">}
          <p style="font-family:'IBM Plex Mono',monospace;font-size:.7rem;color:rgba(201,168,76,0.6);margin-bottom:.5rem">
            {post.data.date?.toLocaleDateString('id-ID', { year:'numeric', month:'long', day:'numeric' })}
          </p>
          <h2 style="font-family:'Cormorant Garamond',serif;font-size:1.4rem;font-weight:700;color:#C9A84C;margin-bottom:.5rem">{post.data.title}</h2>
          <p style="font-size:.85rem;color:rgba(245,240,232,0.55)">{post.body.slice(0,150)}...</p>
        </a>
      ))}
    </div>

    {posts.length === 0 && <p style="text-align:center;color:rgba(245,240,232,0.4);padding:4rem">Belum ada artikel.</p>}
  </div>
</section>
